+SDL_GamepadButtonLabel SDL_GetGamepadButtonLabelForType(SDL_GamepadType type, SDL_GamepadButton button) {
+    const bool playstation = type == SDL_GAMEPAD_TYPE_PS3 || type == SDL_GAMEPAD_TYPE_PS4 || type == SDL_GAMEPAD_TYPE_PS5;
+    switch (button) {
+    case SDL_GAMEPAD_BUTTON_SOUTH: return playstation ? SDL_GAMEPAD_BUTTON_LABEL_CROSS : SDL_GAMEPAD_BUTTON_LABEL_A;
+    case SDL_GAMEPAD_BUTTON_EAST: return playstation ? SDL_GAMEPAD_BUTTON_LABEL_CIRCLE : SDL_GAMEPAD_BUTTON_LABEL_B;
+    case SDL_GAMEPAD_BUTTON_WEST: return playstation ? SDL_GAMEPAD_BUTTON_LABEL_SQUARE : SDL_GAMEPAD_BUTTON_LABEL_X;
+    case SDL_GAMEPAD_BUTTON_NORTH: return playstation ? SDL_GAMEPAD_BUTTON_LABEL_TRIANGLE : SDL_GAMEPAD_BUTTON_LABEL_Y;
+    default: return SDL_GAMEPAD_BUTTON_LABEL_UNKNOWN;
+    }
+}
+SDL_GamepadButtonLabel SDL_GetGamepadButtonLabel(SDL_Gamepad* gamepad, SDL_GamepadButton button) {
+    return SDL_GetGamepadButtonLabelForType(SDL_GetGamepadType(gamepad), button);
+}
+int SDL_GetNumGamepadTouchpads(SDL_Gamepad*) { return 0; }
+int SDL_GetNumGamepadTouchpadFingers(SDL_Gamepad*, int) { return 0; }
+bool SDL_GetGamepadTouchpadFinger(SDL_Gamepad*, int, int, bool* down, float*, float*, float*) {
+    if (down) *down = false;
+    return false;
+}
+bool SDL_RumbleGamepad(SDL_Gamepad* gamepad, Uint16 low, Uint16 high, Uint32 duration_ms) {
+    const int index = PadIndex(gamepad);
+    const auto* host = Host();
+    if (index < 0 || !host || !host->rumble) return false;
+    host->rumble(host->ctx, index, low / 65535.0f, high / 65535.0f, duration_ms);
+    return true;
+}
+bool SDL_SetGamepadLED(SDL_Gamepad*, Uint8, Uint8, Uint8) { return false; }
+
+// ---- events ----
+bool SDL_PollEvent(SDL_Event* event) {
+    if (g_events.empty()) {
+        QueueEvents();
+    }
+    if (g_events.empty()) return false;
+    if (event) *event = g_events.front();
+    g_events.pop_front();
+    return true;
+}
+
+// ---- audio ----
+SDL_AudioStream* SDL_OpenAudioDeviceStream(SDL_AudioDeviceID, const SDL_AudioSpec* spec,
+                                           SDL_AudioStreamCallback, void*) {
+    const auto* host = Host();
+    if (!spec || !host || !host->audio_open) {
+        SetError("no UWP audio");
+        return nullptr;
+    }
+    const int32_t handle = host->audio_open(host->ctx, spec->channels, spec->format == SDL_AUDIO_F32,
+                                            spec->freq);
+    if (handle <= 0) {
+        SetError("XAudio2 voice could not be created");
+        return nullptr;
+    }
+    auto* stream = new AudioStreamData;
+    stream->handle = handle;
+    return reinterpret_cast<SDL_AudioStream*>(stream);
+}
+bool SDL_ResumeAudioStreamDevice(SDL_AudioStream*) { return true; }
+void SDL_DestroyAudioStream(SDL_AudioStream* stream) {
+    auto* data = reinterpret_cast<AudioStreamData*>(stream);
+    if (!data) return;
+    if (const auto* host = Host(); host && host->audio_close) host->audio_close(host->ctx, data->handle);
+    delete data;
+}
+int SDL_GetAudioStreamQueued(SDL_AudioStream* stream) {
+    auto* data = reinterpret_cast<AudioStreamData*>(stream);
+    const auto* host = Host();
+    return data && host && host->audio_queued ? host->audio_queued(host->ctx, data->handle) : 0;
+}
+bool SDL_PutAudioStreamData(SDL_AudioStream* stream, const void* buf, int len) {
+    auto* data = reinterpret_cast<AudioStreamData*>(stream);
+    const auto* host = Host();
+    if (!data || !host || !host->audio_put || !buf || len <= 0) return false;
+    host->audio_put(host->ctx, data->handle, buf, len);
+    return true;
+}
+bool SDL_GetAudioDeviceFormat(SDL_AudioDeviceID, SDL_AudioSpec* spec, int* sample_frames) {
+    const auto* host = Host();
+    if (!host) return false;
+    if (spec) {
+        spec->format = SDL_AUDIO_F32;
+        spec->channels = host->audio_device_channels ? host->audio_device_channels(host->ctx) : 2;
+        spec->freq = 48000;
+    }
+    if (sample_frames) *sample_frames = 480;
+    return true;
+}
+const char* SDL_GetCurrentAudioDriver(void) { return "xaudio2"; }
+
+} // extern "C"
diff --git a/gow3_pc/uwp/uwp_entry.c b/gow3_pc/uwp/uwp_entry.c
new file mode 100644
index 0000000..86b2be9
--- /dev/null
+++ b/gow3_pc/uwp/uwp_entry.c
@@ -0,0 +1,70 @@
+/* gow3 UWP: what gow3-runtime.dll exports to the UWP app (gow3_uwp_host.h).
+ *
+ * The desktop build is gow3-probe.exe, started by tools/probe_tlou.py with a command line and an
+ * environment. A packaged app cannot start processes, so the same program is a DLL here: the app
+ * sets the environment with gow3_uwp_setenv and calls gow3_uwp_run with the command line the PC
+ * staging step wrote (tools/probe_tlou.py --stage). probe.c's main is compiled as
+ * gow3_probe_main for this build (CMakeLists.txt). */
+#if defined(_WIN32) && defined(GOW3_UWP)
+#include <windows.h>
+#include <io.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "gow3_uwp_host.h"
+
+#define EXPORT __declspec(dllexport)
+
+int gow3_probe_main(int argc, char **argv);
+
+static gow3_uwp_host host_table;
+static int host_set;
+
+const gow3_uwp_host *gow3_uwp_host_get(void) { return host_set ? &host_table : NULL; }
+
+EXPORT int32_t gow3_uwp_api_version(void) { return GOW3_UWP_HOST_VERSION; }
+
+EXPORT void gow3_uwp_set_host(const gow3_uwp_host *host) {
+    if (!host || host->version != GOW3_UWP_HOST_VERSION) return;
+    host_table = *host;
+    host_set = 1;
+}
+
+/* Both the CRT's environment (getenv) and the process's (GetEnvironmentVariable): the runtime
+ * reads the first, Vulkan drivers and libraries may read the second. */
+EXPORT int32_t gow3_uwp_setenv(const char *name, const char *value) {
+    if (!name || !*name) return -1;
+    if (_putenv_s(name, value ? value : "")) return -1;
+    wchar_t wname[256], wvalue[4096];
+    if (MultiByteToWideChar(CP_UTF8, 0, name, -1, wname, 256) &&
+        MultiByteToWideChar(CP_UTF8, 0, value ? value : "", -1, wvalue, 4096))
+        SetEnvironmentVariableW(wname, value && *value ? wvalue : NULL);
+    return 0;
+}
+
+EXPORT int32_t gow3_uwp_run(int32_t argc, const char *const *argv, const char *log_path) {
+    if (argc < 2 || !argv) return 2;
+    /* No console in an app: the game's output goes to the log the app shows on failure. */
+    if (log_path && *log_path) {
+        if (freopen(log_path, "w", stdout)) {
+            setvbuf(stdout, NULL, _IOLBF, 0);
+            /* stderr into the same file, unbuffered, as `> boot.log 2>&1` does on the PC. */
+            _dup2(_fileno(stdout), _fileno(stderr));
+            setvbuf(stderr, NULL, _IONBF, 0);
+        }
+    }
+    printf("UWP: gow3-runtime starting (%d arguments)\n", argc);
+    char **copy = calloc((size_t)argc + 1, sizeof(*copy));
+    if (!copy) return 3;
+    for (int i = 0; i < argc; ++i) copy[i] = _strdup(argv[i] ? argv[i] : "");
+    int code = gow3_probe_main(argc, copy);
+    printf("UWP: gow3-runtime returned %d\n", code);
+    fflush(stdout);
+    return code;
+}
+
+BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, LPVOID reserved) {
+    (void)instance; (void)reason; (void)reserved;
+    return TRUE;
+}
+#endif
diff --git a/gow3_pc/uwp/uwp_platform.c b/gow3_pc/uwp/uwp_platform.c
new file mode 100644
index 0000000..be3f498
--- /dev/null
+++ b/gow3_pc/uwp/uwp_platform.c
@@ -0,0 +1,193 @@
+/* gow3 UWP: the app-container versions of the Win32 calls the runtime makes (uwp_platform.h). */
+#if defined(_WIN32) && defined(GOW3_UWP)
+#include <windows.h>
+#include <stdio.h>
+#include <string.h>
+#include <wchar.h>
+#include "uwp_platform.h"
+
+/* The *FromApp functions live in kernelbase (api-ms-win-core-memory-l1-1-*); not every MinGW
+ * import library has all of them, so they are looked up once at run time. */
+typedef PVOID (WINAPI *VirtualAllocFromAppFn)(PVOID, SIZE_T, ULONG, ULONG);
+typedef BOOL (WINAPI *VirtualProtectFromAppFn)(PVOID, SIZE_T, ULONG, PULONG);
+typedef PVOID (WINAPI *VirtualAlloc2FromAppFn)(HANDLE, PVOID, SIZE_T, ULONG, ULONG, MEM_EXTENDED_PARAMETER *, ULONG);
+typedef PVOID (WINAPI *MapViewOfFile3FromAppFn)(HANDLE, HANDLE, PVOID, ULONG64, SIZE_T, ULONG, ULONG,
+                                                MEM_EXTENDED_PARAMETER *, ULONG);
+typedef HANDLE (WINAPI *CreateFileMappingFromAppFn)(HANDLE, PSECURITY_ATTRIBUTES, ULONG, ULONG64, PCWSTR);
+typedef HMODULE (WINAPI *LoadPackagedLibraryFn)(LPCWSTR, DWORD);
+
+static struct {
+    VirtualAllocFromAppFn virtual_alloc;
+    VirtualProtectFromAppFn virtual_protect;
+    VirtualAlloc2FromAppFn virtual_alloc2;
+    MapViewOfFile3FromAppFn map_view3;
+    CreateFileMappingFromAppFn create_file_mapping;
+    LoadPackagedLibraryFn load_packaged;
+} api;
+static INIT_ONCE api_once = INIT_ONCE_STATIC_INIT;
+
+static FARPROC lookup(const char *name) {
+    static const wchar_t *const modules[] = {L"kernelbase.dll", L"kernel32.dll"};
+    for (size_t i = 0; i < sizeof(modules) / sizeof(*modules); ++i) {
+        HMODULE module = GetModuleHandleW(modules[i]);
+        FARPROC p = module ? GetProcAddress(module, name) : NULL;
+        if (p) return p;
+    }
+    fprintf(stderr, "UWP: %s is not available\n", name);
+    return NULL;
+}
+static BOOL CALLBACK resolve(PINIT_ONCE once, PVOID parameter, PVOID *context) {
+    (void)once; (void)parameter; (void)context;
+    api.virtual_alloc = (VirtualAllocFromAppFn)(void (*)(void))lookup("VirtualAllocFromApp");
+    api.virtual_protect = (VirtualProtectFromAppFn)(void (*)(void))lookup("VirtualProtectFromApp");
+    api.virtual_alloc2 = (VirtualAlloc2FromAppFn)(void (*)(void))lookup("VirtualAlloc2FromApp");
+    api.map_view3 = (MapViewOfFile3FromAppFn)(void (*)(void))lookup("MapViewOfFile3FromApp");
+    api.create_file_mapping = (CreateFileMappingFromAppFn)(void (*)(void))lookup("CreateFileMappingFromApp");
+    api.load_packaged = (LoadPackagedLibraryFn)(void (*)(void))lookup("LoadPackagedLibrary");
+    return TRUE;
+}
+static void need_api(void) { InitOnceExecuteOnce(&api_once, resolve, NULL, NULL); }
+
+static PVOID VirtualAllocFromApp_(PVOID a, SIZE_T s, ULONG t, ULONG p) {
+    need_api();
+    if (!api.virtual_alloc) { SetLastError(ERROR_PROC_NOT_FOUND); return NULL; }
+    return api.virtual_alloc(a, s, t, p);
+}
+static BOOL VirtualProtectFromApp_(PVOID a, SIZE_T s, ULONG p, PULONG old) {
+    need_api();
+    if (!api.virtual_protect) { SetLastError(ERROR_PROC_NOT_FOUND); return FALSE; }
+    return api.virtual_protect(a, s, p, old);
+}
+static PVOID VirtualAlloc2FromApp_(HANDLE h, PVOID a, SIZE_T s, ULONG t, ULONG p, MEM_EXTENDED_PARAMETER *x, ULONG n) {
+    need_api();
+    if (!api.virtual_alloc2) { SetLastError(ERROR_PROC_NOT_FOUND); return NULL; }
+    return api.virtual_alloc2(h, a, s, t, p, x, n);
+}
+static PVOID MapViewOfFile3FromApp_(HANDLE f, HANDLE h, PVOID a, ULONG64 o, SIZE_T s, ULONG t, ULONG p,
+                                    MEM_EXTENDED_PARAMETER *x, ULONG n) {
+    need_api();
+    if (!api.map_view3) { SetLastError(ERROR_PROC_NOT_FOUND); return NULL; }
+    return api.map_view3(f, h, a, o, s, t, p, x, n);
+}
+static HANDLE CreateFileMappingFromApp_(HANDLE f, PSECURITY_ATTRIBUTES sa, ULONG p, ULONG64 m, PCWSTR name) {
+    need_api();
+    if (!api.create_file_mapping) { SetLastError(ERROR_PROC_NOT_FOUND); return NULL; }
+    return api.create_file_mapping(f, sa, p, m, name);
+}
+static HMODULE LoadPackagedLibrary_(LPCWSTR name, DWORD reserved) {
+    need_api();
+    /* Outside a package (a desktop test of this DLL) LoadPackagedLibrary fails: LoadLibraryExW then. */
+    HMODULE m = api.load_packaged ? api.load_packaged(name, reserved) : NULL;
+    return m ? m : LoadLibraryExW(name, NULL, LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);
+}
+#define VirtualAllocFromApp VirtualAllocFromApp_
+#define VirtualProtectFromApp VirtualProtectFromApp_
+#define VirtualAlloc2FromApp VirtualAlloc2FromApp_
+#define MapViewOfFile3FromApp MapViewOfFile3FromApp_
+#define CreateFileMappingFromApp CreateFileMappingFromApp_
+#define LoadPackagedLibrary LoadPackagedLibrary_
+
+/* Write and execute at once is what an app container is most likely to refuse, even with
+ * codeGeneration: such requests are retried as execute-read, and reported once. */
+static void report_wx(const char *what, DWORD error) {
+    static volatile LONG reported;
+    if (!InterlockedExchange(&reported, 1))
+        fprintf(stderr, "UWP: %s refused write+execute pages (error %lu): using execute-read\n", what, error);
+}
+static ULONG without_write(ULONG protect) {
+    switch (protect & 0xff) {
+    case PAGE_EXECUTE_READWRITE: case PAGE_EXECUTE_WRITECOPY:
+        return (protect & ~0xffu) | PAGE_EXECUTE_READ;
+    default: return protect;
+    }
+}
+
+PVOID gow3_uwp_virtual_alloc(PVOID address, SIZE_T size, DWORD type, DWORD protect) {
+    PVOID p = VirtualAllocFromApp(address, size, type, protect);
+    if (!p && without_write(protect) != protect) {
+        report_wx("VirtualAllocFromApp", GetLastError());
+        p = VirtualAllocFromApp(address, size, type, without_write(protect));
+    }
+    return p;
+}
+
+BOOL gow3_uwp_virtual_protect(PVOID address, SIZE_T size, DWORD protect, PDWORD old) {
+    ULONG previous = 0;
+    BOOL ok = VirtualProtectFromApp(address, size, protect, &previous);
+    if (!ok && without_write(protect) != protect) {
+        report_wx("VirtualProtectFromApp", GetLastError());
+        ok = VirtualProtectFromApp(address, size, without_write(protect), &previous);
+    }
+    if (old) *old = previous;
+    return ok;
+}
+
+PVOID gow3_uwp_virtual_alloc2(HANDLE process, PVOID base, SIZE_T size, ULONG type, ULONG protect,
+                              MEM_EXTENDED_PARAMETER *parameters, ULONG count) {
+    PVOID p = VirtualAlloc2FromApp(process, base, size, type, protect, parameters, count);
+    if (!p && without_write(protect) != protect) {
+        report_wx("VirtualAlloc2FromApp", GetLastError());
+        p = VirtualAlloc2FromApp(process, base, size, type, without_write(protect), parameters, count);
+    }
+    return p;
+}
+
+PVOID gow3_uwp_map_view3(HANDLE section, HANDLE process, PVOID base, ULONG64 offset, SIZE_T size,
+                         ULONG type, ULONG protect, MEM_EXTENDED_PARAMETER *parameters, ULONG count) {
+    PVOID p = MapViewOfFile3FromApp(section, process, base, offset, size, type, protect, parameters, count);
+    if (!p && without_write(protect) != protect) {
+        report_wx("MapViewOfFile3FromApp", GetLastError());
+        p = MapViewOfFile3FromApp(section, process, base, offset, size, type, without_write(protect),
+                                  parameters, count);
+    }
+    return p;
+}
+
+/* The desktop build asks CreateFileMapping2 for a pagefile-backed SEC_RESERVE section. The app
+ * version has no extended parameters: the allocation attributes go with the page protection. */
+HANDLE gow3_uwp_create_file_mapping2(HANDLE file, SECURITY_ATTRIBUTES *attributes, ULONG access,
+                                     ULONG protect, ULONG allocation, ULONG64 maximum, PCWSTR name,
+                                     MEM_EXTENDED_PARAMETER *parameters, ULONG count) {
+    (void)access; (void)parameters; (void)count;
+    HANDLE h = CreateFileMappingFromApp(file, attributes, protect | allocation, maximum, name);
+    if (!h && (protect & 0xff) == PAGE_EXECUTE_READWRITE) {
+        /* Guest code runs from the loaded image, not from direct memory: a read-write section
+         * still serves the game's data. */
+        fprintf(stderr, "UWP: executable section refused (error %lu): guest memory is read-write only\n",
+                GetLastError());
+        h = CreateFileMappingFromApp(file, attributes, PAGE_READWRITE | allocation, maximum, name);
+    }
+    return h;
+}
+
+/* Packaged apps load DLLs from their package only: a bare file name, looked up in the package. */
+HMODULE gow3_uwp_load_library_w(LPCWSTR name) {
+    if (!name) return NULL;
+    const wchar_t *base = name;
+    for (const wchar_t *c = name; *c; ++c)
+        if (*c == L'\\' || *c == L'/') base = c + 1;
+    HMODULE module = LoadPackagedLibrary(base, 0);
+    /* vulkan-1.dll: the package may carry a driver under another name (GOW3_VULKAN_DLL). */
+    if (!module && !_wcsicmp(base, L"vulkan-1.dll")) {
+        wchar_t chosen[MAX_PATH];
+        if (GetEnvironmentVariableW(L"GOW3_VULKAN_DLL", chosen, MAX_PATH))
+            module = LoadPackagedLibrary(chosen, 0);
+    }
+    return module;
+}
+
+HMODULE gow3_uwp_load_library_a(LPCSTR name) {
+    if (!name) return NULL;
+    wchar_t wide[MAX_PATH];
+    if (!MultiByteToWideChar(CP_UTF8, 0, name, -1, wide, MAX_PATH)) return NULL;
+    return gow3_uwp_load_library_w(wide);
+}
+
+/* GetProcAddress for C++ files that keep <windows.h> out (vk_platform.cpp). */
+void *gow3_uwp_get_proc(void *module, const char *name) {
+    return module && name ? (void *)GetProcAddress((HMODULE)module, name) : NULL;
+}
+
+extern IMAGE_DOS_HEADER __ImageBase;
+HMODULE gow3_uwp_self_module(void) { return (HMODULE)&__ImageBase; }
+#endif
diff --git a/gow3_pc/uwp/uwp_platform.h b/gow3_pc/uwp/uwp_platform.h
new file mode 100644
index 0000000..caa334d
--- /dev/null
+++ b/gow3_pc/uwp/uwp_platform.h
@@ -0,0 +1,43 @@
+/* gow3 UWP: Win32 calls the app container refuses, routed to the ones it allows.
+ *
+ * Include after <windows.h>, only in builds with GOW3_UWP. The memory calls go to the *FromApp
+ * variants (the package declares the codeGeneration capability, which is what lets them map
+ * executable pages); calls with no app-container equivalent (process creation, the multimedia
+ * timer, performance counters) become no-ops that report failure. */
+#pragma once
+#if defined(_WIN32) && defined(GOW3_UWP)
+#include <windows.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+PVOID gow3_uwp_virtual_alloc(PVOID address, SIZE_T size, DWORD type, DWORD protect);
+BOOL gow3_uwp_virtual_protect(PVOID address, SIZE_T size, DWORD protect, PDWORD old);
+PVOID gow3_uwp_virtual_alloc2(HANDLE process, PVOID base, SIZE_T size, ULONG type, ULONG protect,
+                              MEM_EXTENDED_PARAMETER *parameters, ULONG count);
+PVOID gow3_uwp_map_view3(HANDLE section, HANDLE process, PVOID base, ULONG64 offset, SIZE_T size,
+                         ULONG type, ULONG protect, MEM_EXTENDED_PARAMETER *parameters, ULONG count);
+HANDLE gow3_uwp_create_file_mapping2(HANDLE file, SECURITY_ATTRIBUTES *attributes, ULONG access,
+                                     ULONG protect, ULONG allocation, ULONG64 maximum, PCWSTR name,
+                                     MEM_EXTENDED_PARAMETER *parameters, ULONG count);
+HMODULE gow3_uwp_load_library_w(LPCWSTR name);
+HMODULE gow3_uwp_load_library_a(LPCSTR name);
+/* The runtime DLL itself, where the desktop build asked for the executable (GetModuleHandle(NULL)). */
+HMODULE gow3_uwp_self_module(void);
+void *gow3_uwp_get_proc(void *module, const char *name);
+
+#ifdef __cplusplus
+}
+#endif
+
+#define VirtualAlloc gow3_uwp_virtual_alloc
+#define VirtualProtect gow3_uwp_virtual_protect
+#define VirtualAlloc2 gow3_uwp_virtual_alloc2
+#define MapViewOfFile3 gow3_uwp_map_view3
+#define CreateFileMapping2 gow3_uwp_create_file_mapping2
+#undef LoadLibraryW
+#undef LoadLibraryA
+#define LoadLibraryW gow3_uwp_load_library_w
+#define LoadLibraryA gow3_uwp_load_library_a
+#endif
diff --git a/tools/probe_tlou.py b/tools/probe_tlou.py
index f8ed7e8..255ab96 100644
--- a/tools/probe_tlou.py
+++ b/tools/probe_tlou.py
@@ -382,6 +382,54 @@ def image_patches(elf_path, out_path, patches, applied=None):
     return out_path
 
 
+def stage_bundle(stage, command, env, game, update, out, saves, user):
+    """--stage: what the UWP app (Xbox Developer Mode) needs to start the game, written to `stage`.
+
+    The preparation (prepare.py, link_modules.py, the patches) runs here on the PC, as for a normal
+    start; the console cannot run Python. The prepared files are copied to `stage` with boot.json,
+    the runtime's command line and environment with the folders as placeholders the app fills in:
+    ${STAGE} (this folder), ${GAME}, ${UPDATE} (the game and its update on the console) and ${USER}
+    (saves, settings and the shader cache, in the app's own storage)."""
+    stage = Path(stage).resolve()
+    stage.mkdir(parents=True, exist_ok=True)
+    replacements = [(str(out), "${STAGE}"), (str(saves), "${USER}"), (str(user), "${USER}"),
+                    (str(game), "${GAME}")]
+    if update:
+        replacements.insert(0, (str(update), "${UPDATE}"))
+    files = []
+
+    def placeholder(value):
+        value = str(value)
+        path = Path(value)
+        if path.is_file() and out in path.resolve().parents:
+            shutil.copy2(path, stage / path.name)
+            files.append(path.name)
+            return "${STAGE}/" + path.name
+        for prefix, token in replacements:
+            if value == prefix or value.startswith(prefix + os.sep) or value.startswith(prefix + "/"):
+                return token + value[len(prefix):].replace(os.sep, "/")
+        return value
+
+    args = ["gow3-runtime"] + [placeholder(a) for a in command[1:]]
+    skipped = {"GOW3_PAD_RECORD", "GOW3_RESTART_COMMAND", "GOW3_WINDOW_ICON", "GOW3_DUMP_DIR",
+               "GOW3_FRAME_DUMP_TRIGGER"}
+    stage_env = {k: placeholder(v) for k, v in sorted(env.items())
+                 if k.startswith(("GOW3_", "TLOU_")) and k not in skipped and os.environ.get(k) != v
+                 or k in ("GOW3_CONFIG", "GOW3_GPU_USER_DIR", "GOW3_GPU_CACHE_DIR")}
+    stage_env = {k: v for k, v in stage_env.items() if k not in skipped}
+    # The shader cache lives in the app's storage, whatever folder the PC uses.
+    stage_env["GOW3_GPU_CACHE_DIR"] = "${USER}/cache"
+    bundle = {"format": 1, "title": "The Last of Us Remastered", "serial": "CUSA00552",
+              "game_version": app_version(update or game), "has_update": bool(update),
+              "made": time.strftime("%Y-%m-%d %H:%M:%S"), "args": args, "env": stage_env,
+              "files": sorted(set(files))}
+    (stage / "boot.json").write_text(json.dumps(bundle, indent=2), encoding="utf-8")
+    print(f"Staged for the UWP app: {stage} ({len(files)} files, {len(args)} arguments)")
+    print("Copy this folder to the console as TLOU/stage, next to TLOU/CUSA00552"
+          + (" and TLOU/CUSA00552-patch" if update else "") + " (see uwp-app/README.md).")
+    return 0
+
+
 def game_executable():
