+int SDL_strcasecmp(const char* a, const char* b) {
+    if (!a || !b) return a == b ? 0 : (a ? 1 : -1);
+    for (;; ++a, ++b) {
+        const int x = std::tolower(static_cast<unsigned char>(*a));
+        const int y = std::tolower(static_cast<unsigned char>(*b));
+        if (x != y || !x) return x - y;
+    }
