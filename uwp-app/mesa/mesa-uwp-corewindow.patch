diff --git a/src/util/u_dl.c b/src/util/u_dl.c
index 6d8b2b8..8906519 100644
--- a/src/util/u_dl.c
+++ b/src/util/u_dl.c
@@ -47,7 +47,18 @@ util_dl_open(const char *filename)
 #if DETECT_OS_POSIX_LITE
    return (struct util_dl_library *)dlopen(filename, RTLD_LAZY | RTLD_LOCAL);
 #elif DETECT_OS_WINDOWS
-   return (struct util_dl_library *)LoadLibraryA(filename);
+   HMODULE module = LoadLibraryA(filename);
+   if (!module) {
+      /* UWP: a packaged app loads the DLLs of its package with LoadPackagedLibrary. */
+      typedef HMODULE (WINAPI *load_packaged_fn)(LPCWSTR, DWORD);
+      HMODULE kernel = GetModuleHandleA("kernelbase.dll");
+      load_packaged_fn load_packaged = kernel ?
+         (load_packaged_fn)(void (*)(void))GetProcAddress(kernel, "LoadPackagedLibrary") : NULL;
+      WCHAR wide[MAX_PATH];
+      if (load_packaged && MultiByteToWideChar(CP_UTF8, 0, filename, -1, wide, MAX_PATH))
+         module = load_packaged(wide, 0);
+   }
+   return (struct util_dl_library *)module;
 #else
    return NULL;
 #endif
