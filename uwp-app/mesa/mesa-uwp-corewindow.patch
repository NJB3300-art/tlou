 #include <dcomp.h>
 
+/* UWP (Xbox Developer Mode): an app has a CoreWindow, not a desktop HWND, and no DirectComposition.
+ * When MESA_WSI_COREWINDOW holds the address of the app's CoreWindow (an IUnknown*, in hex), the
+ * swapchain is created for that window with CreateSwapChainForCoreWindow; the HWND of the surface is
+ * not used, and the window's size comes from the swapchain (currentExtent = 0xFFFFFFFF). */
+static IUnknown *
+wsi_win32_core_window(void)
+{
+   static IUnknown *window;
+   static bool checked;
+   if (!checked) {
+      const char *value = getenv("MESA_WSI_COREWINDOW");
+      if (value && *value)
+         window = (IUnknown *)(uintptr_t)strtoull(value, NULL, 0);
+      checked = true;
+   }
+   return window;
+}
