<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap mp rescap">

  <Identity Name="TLOU.UwpPort" Publisher="CN=TLOU-UWP" Version="0.2.0.0" ProcessorArchitecture="x64" />

  <mp:PhoneIdentity PhoneProductId="6f2c7a51-3b8e-4d1a-9c55-2e0b7d4f8a13" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>The Last of Us Remastered (UWP port)</DisplayName>
    <PublisherDisplayName>TLOU UWP port</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="TLOUUwp.App">
      <uap:VisualElements
        DisplayName="The Last of Us Remastered (UWP port)"
        Description="Runs your own dump of The Last of Us Remastered (CUSA00552) with the gow3 runtime."
        BackgroundColor="#0E1210"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0E1210" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Executable pages for the game's code (VirtualAllocFromApp / VirtualProtectFromApp). -->
    <Capability Name="codeGeneration" />
    <!-- Wi-Fi transfer: the PC on the same network sends the game folders (port 8077). -->
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <!-- The game on an external drive (E:\TLOU) by its path. -->
    <uap:Capability Name="removableStorage" />
    <rescap:Capability Name="broadFileSystemAccess" />
  </Capabilities>
</Package>
